# Variables de entorno de apps/web. Copiar a .env.local y completar.
# .env.local está gitignoreado; este archivo es la referencia y va al repo.

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server-side (API routes). Bypassea RLS: nunca prefijar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Dominios ─────────────────────────────────────────────────────────────────
# APP_URL (lib/site) sale de acá: es el back_url del checkout de MP y la base del
# redirect_uri del OAuth (lib/gym-mp/credentials.ts arma `${APP_URL}/api/gym-mp/
# callback`). Va SOLO la base, sin el path: si acá ponés la URL completa del
# callback, el path termina duplicado y MP rechaza el canje.
#
# En local, `http://localhost:3000` alcanza para todo MENOS el OAuth de MP, que
# necesita una URL pública y fija. Para eso está el túnel de Cloudflare: se corre
# `cloudflared tunnel run <nombre>` apuntando al puerto 3000 y acá va
# https://dev.gymtrack.ar (o dev-work.gymtrack.ar en la otra máquina). Los dos
# hostnames están reservados en middleware.ts para que no se confundan con slugs
# de gimnasio, y los dos callbacks tienen que estar registrados en el panel de MP.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_ROOT_DOMAIN=

# ── Sentry (opcional; sin DSN queda inactivo) ────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=

# ── MercadoPago ──────────────────────────────────────────────────────────────
# Access token de la app cobradora. Es LA MISMA variable con distinto valor por
# entorno: en local y en previews va el token de un vendedor de PRUEBA, en
# producción el productivo. No se puede distinguir uno de otro por el prefijo
# (los dos empiezan con APP_USR-), de ahí las dos variables de abajo.
MP_ACCESS_TOKEN=
#
# Id de la aplicación de MP del vendedor de prueba. CARGARLA EN TODOS LOS
# ENTORNOS, producción incluida: es lo que frena que un token de prueba estrene
# una suscripción sobre un gimnasio real (el gym tiene que estar marcado como de
# prueba desde el panel: /platform/gyms/[id] → "Gimnasio de prueba"). Sin esta
# variable la guarda queda inerte. Es un id, no un secreto.
MP_TEST_APPLICATION_ID=
#
# Email del comprador de prueba de MP. Reemplaza al del owner como payer_email
# (MP exige que vendedor y pagador sean los dos reales o los dos de prueba).
# Se ignora en producción por VERCEL_ENV, así que es inofensiva si queda cargada.
MP_TEST_PAYER_EMAIL=

# ── MercadoPago OAuth: cobros del gym a sus socios ───────────────────────────
# Nada que ver con MP_ACCESS_TOKEN de arriba. Ese es el token de NUESTRA cuenta,
# con el que le cobramos el abono al gimnasio. Estas dos son las credenciales de
# la aplicación de marketplace con la que cada gym nos autoriza a cobrarle a SUS
# socios: la plata de esos cobros cae en la cuenta del gimnasio y nunca pasa por
# la nuestra.
#
# En el panel de MP hay que habilitar OAuth en la aplicación y registrar el
# redirect URI EXACTO: https://<dominio>/api/gym-mp/callback. MP rechaza el canje
# si difiere en un carácter.
#
# Estas dos van TAMBIÉN como secrets de Supabase (ver el bloque de abajo): la
# edge function que cobra renueva el token del gym por su cuenta si está por
# vencer, y necesita las mismas credenciales.
MP_OAUTH_CLIENT_ID=
MP_OAUTH_CLIENT_SECRET=

# ── Vercel Cron ──────────────────────────────────────────────────────────────
# Lo genera Vercel al agregar el primer cron y lo manda como
# `Authorization: Bearer $CRON_SECRET`. En local no hace falta: sin la variable,
# /api/cron/* acepta una sesión de super_admin para poder dispararlo a mano.
CRON_SECRET=

# ── Cobranza (/admin/cobranza) ────────────────────────────────────────────────
# El MISMO valor que ya está cargado como secret de las edge functions (ver el
# bloque de abajo). Acá hace falta además porque /api/cobranza/preview y
# /api/cobranza/test llaman a send-email directo, server-to-server, para que el
# preview del canvas sea el mail real y no una segunda implementación.
INTERNAL_FUNCTION_SECRET=

# ═════════════════════════════════════════════════════════════════════════════
# Secrets de las EDGE FUNCTIONS (Supabase → Edge Functions → Secrets)
# ═════════════════════════════════════════════════════════════════════════════
# NO van en este archivo ni en Vercel: las edge functions corren en Supabase y
# leen su propio entorno. Se listan acá porque hasta ahora solo estaban en
# PROD_CHECKLIST.md y no había un lugar donde ver el set completo de una.
#
# ── Firma de los webhooks (mp-webhook, mp-gym-webhook) ───────────────────────
# SIN ESTAS, LOS WEBHOOKS RECHAZAN TODO CON 401. Es a propósito: un aviso que no
# se puede validar no se procesa. Cargarlas ANTES de deployar las funciones, o
# ninguna suscripción se activa y ningún pago de socio se registra.
#   MP_WEBHOOK_SECRET       – clave de la app real (Tus integraciones > Webhooks)
#   MP_WEBHOOK_SECRET_TEST  – clave de la app del vendedor de prueba
#   MP_GYM_WEBHOOK_SECRET   – clave de la app de marketplace
#
# ── Resto de lo que usan las funciones ───────────────────────────────────────
#   MP_ACCESS_TOKEN         – token de la app real (lo usan mp-webhook y eliminar-gym)
#   MP_ACCESS_TOKEN_TEST    – token del vendedor de prueba
#   MP_TEST_APPLICATION_ID  – id de la app de prueba, para elegir credenciales
#   MP_GYM_WEBHOOK_URL      – https://<ref>.supabase.co/functions/v1/mp-gym-webhook
#                             Sin esta, crear-cobro-socio se NIEGA a cobrar: un
#                             pago sin webhook se cobra y nunca se registra.
#   MP_OAUTH_CLIENT_ID      – las mismas dos de arriba. Habilitan que
#   MP_OAUTH_CLIENT_SECRET    crear-cobro-socio renueve el token del gym si está
#                             por vencer, en vez de depender solo del cron diario.
#                             Sin ellas se cobra igual con el token que haya.
#   APP_DEEP_LINK           – opcional, default gymtrack://
#
# ── send-email / cobranza-recordatorios ──────────────────────────────────────
#   INTERNAL_FUNCTION_SECRET – secreto compartido entre edge functions (y con
#                             /api/cobranza/* de arriba) para el canal
#                             server-to-server: sin él, send-email y
#                             cobranza-recordatorios responden 401 a todo.
#   RESEND_API_KEY          – API key de Resend, para mandar los mails.
#   APP_URL                 – opcional para cobranza-recordatorios, default
#                             https://www.gymtrack.ar. Base de la página de
#                             vuelta del checkout (/pago/gracias) que llevan
#                             los links de pago del mail de cobranza.
