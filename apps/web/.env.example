# Variables de entorno de apps/web. Copiar a .env.local y completar.
# .env.local está gitignoreado; este archivo es la referencia y va al repo.

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server-side (API routes). Bypassea RLS: nunca prefijar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Dominios ─────────────────────────────────────────────────────────────────
# APP_URL (lib/site) sale de acá: es el back_url del checkout de MP.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_ROOT_DOMAIN=

# ── Sentry (opcional; sin DSN queda inactivo) ────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=

# ── MercadoPago ──────────────────────────────────────────────────────────────
# Access token de la app cobradora. Es LA MISMA variable con distinto valor por
# entorno: en local y en previews va el token de un vendedor de PRUEBA, en
# producción el productivo. No se puede distinguir uno de otro por el prefijo
# (los dos empiezan con APP_USR-), de ahí las dos variables de abajo.
MP_ACCESS_TOKEN=
#
# Id de la aplicación de MP del vendedor de prueba. CARGARLA EN TODOS LOS
# ENTORNOS, producción incluida: es lo que frena que un token de prueba estrene
# una suscripción sobre un gimnasio real (el gym tiene que estar marcado como de
# prueba desde el panel: /platform/gyms/[id] → "Gimnasio de prueba"). Sin esta
# variable la guarda queda inerte. Es un id, no un secreto.
MP_TEST_APPLICATION_ID=
#
# Email del comprador de prueba de MP. Reemplaza al del owner como payer_email
# (MP exige que vendedor y pagador sean los dos reales o los dos de prueba).
# Se ignora en producción por VERCEL_ENV, así que es inofensiva si queda cargada.
MP_TEST_PAYER_EMAIL=

# ── MercadoPago OAuth: cobros del gym a sus socios ───────────────────────────
# Nada que ver con MP_ACCESS_TOKEN de arriba. Ese es el token de NUESTRA cuenta,
# con el que le cobramos el abono al gimnasio. Estas dos son las credenciales de
# la aplicación de marketplace con la que cada gym nos autoriza a cobrarle a SUS
# socios: la plata de esos cobros cae en la cuenta del gimnasio y nunca pasa por
# la nuestra.
#
# En el panel de MP hay que habilitar OAuth en la aplicación y registrar el
# redirect URI EXACTO: https://<dominio>/api/gym-mp/callback. MP rechaza el canje
# si difiere en un carácter.
MP_OAUTH_CLIENT_ID=
MP_OAUTH_CLIENT_SECRET=

# ── Vercel Cron ──────────────────────────────────────────────────────────────
# Lo genera Vercel al agregar el primer cron y lo manda como
# `Authorization: Bearer $CRON_SECRET`. En local no hace falta: sin la variable,
# /api/cron/* acepta una sesión de super_admin para poder dispararlo a mano.
CRON_SECRET=
